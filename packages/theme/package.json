{
  "name": "@blocky/theme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint assets/js --ext .ts --max-warnings=0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix"
  },
  "dependencies": {
    "@blocky/tokens": "workspace:*",
    "@blocky/ui-primitives": "workspace:*"
  },
  "devDependencies": {
    "@blocky/eslint-config": "workspace:*",
    "@blocky/tsconfig": "workspace:*",
    "@types/node": "^20.14.2",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  }
}
