{
  "name": "@blocky/builder-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:tailwind-catalog": "node scripts/generate-tailwind-catalog.mjs",
    "build": "pnpm run generate:tailwind-catalog && vite build",
    "dev":   "pnpm run generate:tailwind-catalog && vite",
    "typecheck": "pnpm run generate:tailwind-catalog && tsc --noEmit"
  },
  "dependencies": {
    "preact":                 "^10.22.1",
    "@preact/signals":        "^1.2.3",
    "zustand":                "^4.5.4",
    "immer":                  "^10.1.1",
    "@blocky/tokens":         "workspace:*",
    "@blocky/ui-primitives":  "workspace:*"
  },
  "devDependencies": {
    "@blocky/tsconfig":       "workspace:*",
    "@blocky/eslint-config":  "workspace:*",
    "typescript":             "^5.5.4",
    "vite":                   "^5.3.5",
    "@preact/preset-vite":    "^2.8.1",
    "tailwindcss":            "^4.0.0",
    "@tailwindcss/vite":      "^4.0.0"
  }
}
